# --- Cambiar de documento ---
open_last_document	gt
open_last_document	<C-<tab>>
open_prev_doc	gT
open_prev_doc	<C-p>
open_document_embedded	<C-o>

# --- Navegacion intuitiva ---
goto_beginning	<home>
goto_end	<end>
goto_page_with_page_number	<C-g>
goto_toc	<C-t>
prev_state	<A-<left>>
next_state	<A-<right>>

# --- Zoom estilo navegador ---
zoom_in	<C-=>
zoom_out	<C-->
fit_to_page_width_smart	<C-0>

# --- Busqueda ---
next_item	<f3>
previous_item	<S-<f3>>

# --- Marcadores y vista ---
add_bookmark	<C-b>
goto_bookmark	<C-S-b>
toggle_custom_color	<f6>
toggle_statusbar	<f2>

# --- Salir ---
quit	<C-w>
quit	<C-q>

# --- Traductor ---
execute_predefined_command	<A-t>

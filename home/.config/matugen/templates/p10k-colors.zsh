# Generado desde el fondo de pantalla (palette.py + matugen) — no editar a mano
# (plantilla: ~/.config/matugen/templates/p10k-colors.zsh)

# Izquierda: usuario / carpeta / git
typeset -g POWERLEVEL9K_USER_BACKGROUND='{{pal.p10k_user}}'

/* Diseño 2 · Pantalla completa — velo oscuro (Hyprland lo desenfoca) con tarjetas */
@import "~/.config/rofi/colors.rasi"

configuration { show-icons: false; }

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg0;
}

window {
    fullscreen: true;
    background-color: @bg-veil;
    border: 0px;
}

mainbox {
    children: [ dummy-top, avatar-row, message, listview, dummy-bottom ];
    spacing: 34px;
    padding: 0px;
}

dummy-top    { expand: true; }

/* Avatar centrado (menu.sh pone la imagen; si no hay, se oculta) */
avatar-row {
    orientation: horizontal;
    expand: false;
    children: [ avatar-left, icon-avatar, avatar-right ];
}
avatar-left, avatar-right { expand: true; }
icon-avatar {
    size: 110px;
    expand: false;
}
dummy-bottom { expand: true; }

message {
    background-color: transparent;
    border: 0px;
}
textbox {
    horizontal-align: 0.5;
    text-color: @fg0;
    font: "JetBrainsMono Nerd Font Bold 72";
}

listview {
    columns: 5;  /* lo ajusta menu.sh */
    lines: 1;
    flow: horizontal;
    fixed-columns: true;
    fixed-height: true;
    expand: false;
    spacing: 22px;
    margin: 0px 30%;   /* menu.sh lo recalcula según el monitor */
    scrollbar: false;
}

element {
    padding: 26px 0px 20px 0px;
    border: 2px;
    border-radius: 24px;
    border-color: @border-soft;
    background-color: @bg-glass;
    text-color: @fg1;
    cursor: pointer;
}
element selected.normal {
    background-color: @accent-soft;
    border-color: @accent;
    text-color: @accent;
}
element-text {
    font: "JetBrainsMono Nerd Font 20";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
inputbar { enabled: false; }

configuration {
  show-icons: false;
}

* {
  background: transparent;
  foreground: #ffffff;
  border-color: rgba(196, 16, 71, 0.86);
  selected: rgba(255, 255, 255, 0.16);
  font: "JetBrainsMono Nerd Font 12";
}

window {
  location: center;
  anchor: center;
  width: 260px;
  x-offset: 0px;
  y-offset: 0px;
  border: 2px;
  border-radius: 10px;
  border-color: @border-color;
  background-color: rgba(30, 30, 46, 0.82);
}

mainbox {
  padding: 8px;
  background-color: transparent;
}

inputbar {
  enabled: false;
}

listview {
  lines: 3;
  fixed-height: true;
  background-color: transparent;
}

element {
  padding: 10px 16px;
  border-radius: 8px;
  background-color: transparent;
}

element selected {
  background-color: @selected;
}

element-text {
  horizontal-align: 0.5;
  text-color: @foreground;
  background-color: transparent;
}

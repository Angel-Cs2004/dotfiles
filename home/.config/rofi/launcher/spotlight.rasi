/* Lanzador · Diseño 2: Spotlight / Raycast — barra de búsqueda ancha + lista con descripción */
@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons: true;
    icon-theme: "breeze-dark";
}

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg0;
}

window {
    location: north;
    anchor: north;
    y-offset: 22%;
    width: 700px;
    border: 2px;
    border-radius: 22px;
    border-color: @border-soft;
    background-color: @bg-glass;
}

mainbox {
    padding: 0px;
    spacing: 0px;
    children: [ inputbar, separator, listview, hints ];
}

inputbar {
    padding: 20px 24px;
    spacing: 14px;
    children: [ textbox-search, entry ];
}
textbox-search {
    expand: false;
    str: "󰍉";
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 17";
    vertical-align: 0.5;
}
entry {
    placeholder: "¿Qué quieres abrir?";
    placeholder-color: @fg2;
    font: "JetBrainsMono Nerd Font 16";
    vertical-align: 0.5;
    cursor: text;
}

separator {
    expand: false;
    border: 1px 0px 0px 0px;
    border-color: @border-soft;
    margin: 0px 18px;
}

listview {
    lines: 6;
    columns: 1;
    fixed-height: false;
    padding: 10px 10px 6px 10px;
    spacing: 4px;
    scrollbar: false;
    cycle: true;
}

element {
    orientation: horizontal;
    padding: 9px 14px;
    spacing: 14px;
    border: 0px 0px 0px 3px;
    border-radius: 14px;
    border-color: transparent;
    background-color: transparent;
    text-color: @fg0;
    cursor: pointer;
}
element selected.normal {
    background-color: @accent-soft;
    border-color: @accent;
    text-color: @fg0;
}
element-icon {
    size: 34px;
    vertical-align: 0.5;
    cursor: inherit;
}
element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
    markup: true;
}

hints {
    orientation: horizontal;
    expand: false;
    padding: 8px 22px 14px 22px;
    children: [ textbox-hints ];
}
textbox-hints {
    str: "↑↓  moverse     ↵  abrir     esc  salir";
    horizontal-align: 0.5;
    text-color: @fg2;
    font: "JetBrainsMono Nerd Font 9";
}

message { border: 0px; padding: 10px 24px; }
textbox { text-color: @fg1; }

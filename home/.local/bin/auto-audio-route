#!/usr/bin/env bash
set -u

FALLBACK_SINK="${FALLBACK_SINK:-alsa_output.pci-0000_00_1f.3.analog-stereo}"

pick_bluetooth_sink() {
  pactl list short sinks | awk '$2 ~ /^bluez_output\./ { print $2; exit }'
}

pick_fallback_sink() {
  if pactl list short sinks | awk -v sink="$FALLBACK_SINK" '$2 == sink { found = 1 } END { exit !found }'; then
    printf '%s\n' "$FALLBACK_SINK"
    return
  fi

  pactl list short sinks | awk '$2 ~ /^alsa_output\..*analog-stereo$/ { print $2; exit }'
}

current_default_sink() {
  pactl info | awk -F': ' '/Default Sink/ { print $2; exit }'
}

route_audio() {
  local sink current

  sink="$(pick_bluetooth_sink)"
  if [[ -z "$sink" ]]; then
    sink="$(pick_fallback_sink)"
  fi

  [[ -n "$sink" ]] || return 0

  current="$(current_default_sink)"
  if [[ "$current" != "$sink" ]]; then
    pactl set-default-sink "$sink" || return 0
  fi

  pactl list short sink-inputs |
    awk '{ print $1 }' |
    while read -r input_id; do
      [[ -n "$input_id" ]] && pactl move-sink-input "$input_id" "$sink" >/dev/null 2>&1 || true
    done
}

route_audio

pactl subscribe | while read -r event; do
  case "$event" in
    *" on sink "*|*" on card "*|*" on server "*|*" on sink-input "*)
      sleep 0.3
      route_audio
      ;;
  esac
done
